LOG_LEVEL=INFO
LOG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YYYYYYYY/YYYYYYYY
LOG_DISCORD_WEBHOOK_LEVEL=WARNING
# INTERNET_ARCHIVE_EMAIL=user@example.com
# INTERNET_ARCHIVE_PASSWORD=password
# TWSCRAPER_COOKIES="auth_token=...; ct0=..."
TWS_TELEMETRY=0
SERVICE_FAILURE_THRESHOLD=10
SERVICE_DISABLE_SECONDS=3600
SERVICE_DISABLE_ERROR_THRESHOLD=24
USER_AGENT_BETTERTWITFIX=https://github.com/EthanC/Bluebird
USER_AGENT_CARRYFEED="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
USER_AGENT_FXEMBED=https://github.com/EthanC/Bluebird
DISABLE_TWSCRAPER=false
DISABLE_BETTERTWITFIX=false
DISABLE_CARRYFEED=false
DISABLE_FXEMBED=false
